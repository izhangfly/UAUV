        <mxCell id="e_A_dec1" value="optimum x*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#000000;" edge="1" parent="1" source="layerA" target="dec1"><mxGeometry relative="1" as="geometry" /></mxCell>
